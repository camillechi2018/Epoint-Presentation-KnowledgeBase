      "shape_id": 25,
      "shape_name": "文本框 24",
      "type": "text",
      "max_chars": 117,
      "source_sample_chars": 74,
      "source_text": "采用“时间块”技术，将时间分段安排，避免工作时间过长导致精力消耗殆尽。\n定期评估自己的工作效率，必要时调整工作安排，避免因低效率导致无谓的工作堆积。",
      "bounds_pt": [
        43.2,
        130.7,
        320.6,
        88.4
      ],
      "semantic_path": "work_items[0].body",
      "max_lines": 2,

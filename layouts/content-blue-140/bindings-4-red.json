      "shape_name": "文本框 34",
      "type": "text",
      "max_chars": 7,
      "source_sample_chars": 8,
      "source_text": "保持健康生活方式",
      "bounds_pt": [
        756.4,
        232.6,
        133.2,
        24.2
      ],
      "semantic_path": "life_items[1].title",
      "max_lines": 1,
